<mjml lang="{{ lang }}">
  <mj-head>
    <mj-title>Login Location</mj-title>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body background-color="#f5f6fe" width="552px">
    <mj-include path="./partials/logo.mjml" />
    <mj-wrapper padding="0 16px 32px">
      <mj-section mj-class="card">
        <mj-column>
          <mj-text mj-class="title">{{ unknown_location }}</mj-text>
          <mj-text>
            IP: <b>{{ ip }}</b>
            {%- if !location.is_empty() %} ({{ location }}){% endif %}<br />
            {{ user_agent }}
          </mj-text>
          <mj-text>{{ if_invalid }}</mj-text>
          <mj-button href="{{ link_revoke }}">{{ revoke_link }}</mj-button>
          <mj-button mj-class="secondary" href="{{ link_account }}">{{ account_link }}</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
