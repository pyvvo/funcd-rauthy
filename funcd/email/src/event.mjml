<mjml lang="{{ lang }}">
  <mj-head>
    <mj-title>Event</mj-title>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body background-color="#f5f6fe" width="552px">
    <mj-include path="./partials/logo.mjml" />
    <mj-wrapper padding="0 16px 32px">
      <mj-section mj-class="card">
        <mj-column>
          <mj-text mj-class="title">{{ head }}</mj-text>
          <mj-text>{{ row_1 }}</mj-text>
          <mj-raw>{%- if !row_2.is_empty() -%}</mj-raw>
          <mj-text>{{ row_2 }}</mj-text>
          <mj-raw>{%- endif -%}</mj-raw>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
